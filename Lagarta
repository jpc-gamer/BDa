* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #f5f5f5;
    color: #4a241b;
    font-family: Arial, sans-serif;
}

header {
    margin-top: 0;
    background-color: #ffffff;
}

.menu {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 95px;
}

.logo {
    color: #3f2419;
    font-family: Georgia, serif;
    font-size: 24px;
    font-weight: bold;
    text-decoration: none;
}

.nav_links {
    display: flex;
    gap: 45px;
    list-style: none;
}

.nav_links a {
    color: #3f2419;
    font-family: Georgia, serif;
    font-size: 16px;
    text-decoration: none;
    transition: 0.2s;
}

.nav_links a:hover {
    color: #7d1f1f;
    text-decoration: underline;
    text-underline-offset: 7px;
}

.botao_consulta {
    background-color: #7d1f1f;
    color: white;
    padding: 11px 22px;
    border-radius: 5px;
    font-family: Georgia, serif;
    font-weight: bold;
    text-decoration: none;
}

.principal {
    background-color: #fff1d2;
}

.container_principal {
    height: 423px;
    display: flex;
}

.principal_texto {
    width: 55%;
    padding: 58px 30px 40px 67px;
}

.titulo_principal {
    max-width: 480px;
    color: #4a241b;
    font-family: Georgia, serif;
    font-size: 48px;
    line-height: 1.3;
    font-weight: bold;
}

.titulo_principal span {
    color: #7d1f1f;
}

.titulo_principal::after {
    content: "";
    display: block;
    width: 100px;
    height: 2px;
    background-color: #bd9851;
    margin-top: 13px;
}

.descricao {
    max-width: 390px;
    margin-top: 16px;
    color: #3f312c;
    font-size: 15px;
    line-height: 1.5;
}

.botao_contato {
    display: inline-block;
    margin-top: 42px;
    padding: 10px 20px;
    background-color: #7d1f1f;
    color: white;
    border-radius: 4px;
    font-family: Georgia, serif;
    font-weight: bold;
    text-decoration: none;
}

.botao_contato::after {
    content: " →";
    font-size: 18px;
}

.imagem_estatua {
    width: 45%;
    height: 423px;
    margin: 0;
    overflow: hidden;
}

.imagem_estatua img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
}

.barra-estatisticas {
    background-color: #7d1f1f;
}

.grade-estatisticas {
    height: 84px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
}

.item-estatistica {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    position: relative;
}

.item-estatistica:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 16px;
    width: 2px;
    height: 53px;
    background-color: #bd9851;
}

.imagem-icone-estatistica {
    width: 40px;
    height: 40px;
    object-fit: contain;
}

.item-estatistica p {
    display: flex;
    flex-direction: column;
}

.numero-estatistica {
    color: #fff7df;
    font-family: Georgia, serif;
    font-size: 30px;
    font-weight: normal;
    margin-bottom: 6px;
}

.rotulo-estatistica {
    color: #fff7df;
    font-family: Georgia, serif;
    font-size: 10px;
    text-transform: uppercase;
}

.titulo-areas {
    margin-top: 40px;
    color: #4a241b;
    font-size: 26px;
    margin-left: 300px;
    margin-bottom: 5px;
}

.linha {
    width: 80px;
    height: 1px;
    background-color: #4a241b;
    margin-left: 300px;
}

.areas-atuacao {
    display: flex;
    justify-content: center;
    gap: 25px;
    padding: 30px;
    height: 350px;
}

.cartao {
    width: 220px;
    height: 280px;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
}

.titulo-cartao {
    font-size: 19px;
    color: #4a241b;
    margin-bottom: 15px;
}

.icone-cartao {
    width: 80px;
    height: 80px;
    margin-bottom: 15px;
}

.descricao-cartao {
    font-size: 13px;
    color: #666;
    margin-bottom: 20px;
}

.link-cartao {
    font-size: 13px;
    color: #4a241b;
    text-decoration: none;
}

.link-cartao:hover {
    text-decoration: underline;
}

.sobre {
    display: flex;
    align-items: center;
    gap: 50px;
    padding: 50px 60px;
}

.img_advogada {
    width: 350px;
    height: 350px;
}

.img_advogada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.sobre_texto {
    text-align: left;
}

.sobre_titulo {
    color: #4a241b;
    font-size: 26px;
    margin-bottom: 15px;
}

.sobre_descricao {
    color: #666;
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 20px;
}

.check_list {
    list-style: none;
    padding: 0;
}

.check_list li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    color: #4a241b;
}

.check_list img {
    width: 18px;
    height: 18px;
}

.botao_contato {
    display: inline-block;
    margin-top: 15px;
    padding: 10px 25px;
    background-color: #4a241b;
    color: white;
    text-decoration: none;
    border-radius: 5px;
}
